{
  "permissions": {
    "deny": [
      "Read(**/key.properties)",
      "Edit(**/key.properties)",
      "Read(~/.itheros/**)",
      "Edit(~/.itheros/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", ".claude/hooks/production-gate.ps1"],
            "timeout": 15,
            "statusMessage": "Checking the production gate"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", ".claude/hooks/protect-accepted.ps1"],
            "timeout": 15,
            "statusMessage": "Checking SDLC artifact status"
          },
          {
            "type": "command",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", ".claude/hooks/protect-tests.ps1"],
            "timeout": 15,
            "statusMessage": "Checking test lock"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", ".claude/hooks/format-dart.ps1"],
            "timeout": 30,
            "statusMessage": "dart format"
          }
        ]
      }
    ]
  }
}
