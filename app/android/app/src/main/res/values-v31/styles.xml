<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- From Android 12 the launch window is the system splash screen, which
         does not use launch_background. It is dark too (spec 0014 §3.3). -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/case_black</item>
    </style>
</resources>
